# ============================================================
# web-console-starter backend env template
# copy to .env and edit (init-app.ps1 auto-generates .env)
# ============================================================

# HTTP port the backend listens on
PORT=3000

# SQLite file location (relative to backend/ cwd)
DB_PATH=./data/app.db

# JWT signing secret - MUST change for any real deployment
JWT_SECRET=CHANGE_ME_generate_a_random_32_char_secret
# token lifetime, e.g. 12h / 7d
TOKEN_TTL=12h

# seed accounts created on first boot when users table is empty
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=admin123
SEED_OPERATOR_USER=operator
SEED_OPERATOR_PASS=op123456
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASS=view123456
